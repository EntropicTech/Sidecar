# Maintainer: EntropicTech (https://github.com/EntropicTech)
# Generated by packaging/release.py. Do not publish an unchecked local recipe.
pkgname=igpu-man
pkgver=0.1.0
pkgrel=1
pkgdesc='Sidecar: route desktop apps to the iGPU and verify GPU activity'
url='https://github.com/EntropicTech/Sidecar'
arch=('x86_64')
license=('MIT')
# Cargo release artifacts are already stripped; retain manifest hashes.
# Bundled SQLite is C; GCC object LTO is incompatible with Rust/LLVM linking.
# Cargo retains its own thin Rust LTO.
options=('!strip' '!lto' '!debug')
depends=('libgcc' 'hicolor-icon-theme' 'glibc' 'dbus' 'systemd' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcb' 'fontconfig')
makedepends=('rust>=1.89' 'cargo' 'pkgconf' 'python')
optdepends=('mangohud: game frame logging' 'lib32-mangohud: 32-bit game frame logging'
            'qt6-tools: KWin diagnostics through qdbus6' 'kscreen: current monitor settings'
            'libnotify: optional local notifications')
optdepends+=('pciutils: descriptive GPU model names')
source=("https://github.com/EntropicTech/Sidecar/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --workspace --release --frozen
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --workspace --frozen
  python3 tests/check_docs.py
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
