[Unit]
Description=Sidecar GPU workload collector
Documentation=https://docs.kernel.org/gpu/drm-usage-stats.html
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=io.github.igpu_man.Collector
ExecStart=/usr/bin/igpu-mand
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
# User-service mount sandboxing can create a user namespace that prevents
# same-account /proc/PID/{exe,fdinfo} inspection. Keep procfs accounting usable.
PrivateTmp=no
ProtectSystem=no
PrivateUsers=no

[Install]
WantedBy=graphical-session.target
